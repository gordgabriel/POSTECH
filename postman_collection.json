          }
        },
        {
          "name": "Detalhar OS",
          "request": { "method": "GET", "url": "{{base_url}}/api/ordens-servico/{{os_id}}/" }
        },
        {
          "name": "Registrar diagnóstico (→ EmDiagnostico)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_mecanico}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diagnostico\": \"Correia do alternador desgastada — recomendada troca\"\n}"
            },
            "url": "{{base_url}}/api/ordens-servico/{{os_id}}/diagnosticar/",
            "description": "Comando Realizar diagnóstico: grava o parecer do mecânico e leva a OS para EmDiagnostico. Parecer vazio retorna 400. Transição inválida retorna 400 e não grava o parecer."
          }
        },
        {
          "name": "Finalizar OS (→ Finalizada)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_mecanico}}", "type": "string" }] },
            "method": "POST",
            "url": "{{base_url}}/api/ordens-servico/{{os_id}}/finalizar/",
            "description": "Comando Finalizar OS. Só a partir de EmExecucao; carimba data_finalizacao."
          }
        },
        {
          "name": "Registrar entrega (→ Entregue, baixa estoque)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/ordens-servico/{{os_id}}/entregar/",
            "description": "Comando Registrar entrega do veículo. Só a partir de Finalizada. Carimba data_entrega e baixa do estoque as peças utilizadas."
          }
        },
        {
          "name": "Cancelar OS (→ Cancelada, libera reservas)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/ordens-servico/{{os_id}}/cancelar/",
            "description": "Comando Cancelar OS. Válido até AguardandoAprovacao; a partir de EmExecucao retorna 400. Libera as peças reservadas."
          }
        },
        {
          "name": "PATCH de status (deve ser ignorado)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
